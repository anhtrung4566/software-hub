<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>9c1f4a20-3b7e-4e82-9a11-7d5c2b8f3004</Id>
  <Version>3.0.0.0</Version>
  <ProviderName>VBTM Pro</ProviderName>
  <DefaultLocale>vi-VN</DefaultLocale>
  <DisplayName DefaultValue="VBTM PRO AI FOR OUTLOOK"/>
  <Description DefaultValue="Trợ lý AI soạn email công vụ, tóm tắt chuỗi thư, trích xuất nhiệm vụ và chuyển email thành dự thảo công văn ngay trong Classic &amp; New Outlook."/>
  <IconUrl DefaultValue="https://anhtrung4566.github.io/software-hub/desktop-src/VBTM-Pro/VBTM-Pro-logo.png"/>
  <HighResolutionIconUrl DefaultValue="https://anhtrung4566.github.io/software-hub/desktop-src/VBTM-Pro/VBTM-Pro-logo.png"/>
  <SupportUrl DefaultValue="https://anhtrung4566.github.io/software-hub/products/vbtm-pro.html"/>
  <AppDomains>
    <AppDomain>https://anhtrung4566.github.io</AppDomain>
    <AppDomain>https://generativelanguage.googleapis.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://anhtrung4566.github.io/software-hub/office-addins/VBTM.OutlookAddin/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="VbtmProOutlookReadGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="VbtmProOutlookReadBtn">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="VbtmProOutlookComposeGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="VbtmProOutlookComposeBtn">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://anhtrung4566.github.io/software-hub/desktop-src/VBTM-Pro/VBTM-Pro-logo.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://anhtrung4566.github.io/software-hub/desktop-src/VBTM-Pro/VBTM-Pro-logo.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://anhtrung4566.github.io/software-hub/desktop-src/VBTM-Pro/VBTM-Pro-logo.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://anhtrung4566.github.io/software-hub/office-addins/VBTM.OutlookAddin/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="VBTM PRO AI"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="VBTM PRO AI"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Mở Trợ lý VBTM PRO AI ngay trong Outlook (không tự động gửi thư)."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
